{
  // Specra debug configurations.
  //
  // Java entries need the "Extension Pack for Java" (see extensions.json); the
  // web entries work with the built-in JavaScript debugger.
  //
  // Start here:  Run and Debug ▸ "Full stack (API + Web)"
  "version": "0.2.0",
  "configurations": [
    // ── API ──────────────────────────────────────────────────────────────────
    {
      "type": "java",
      "name": "API: Spring Boot",
      "request": "launch",
      "mainClass": "dev.specra.api.SpecraApiApplication",
      "projectName": "specra-api",
      "cwd": "${workspaceFolder}/apps/api",
      // Creates .env from .env.example if missing, then waits for Postgres to
      // report healthy — so the API never races the database on startup.
      "preLaunchTask": "specra: db up",
      // No -Dspring.docker.compose.enabled=false here. The repo has one compose
      // file with a pinned project name, and application.yml points
      // spring.docker.compose.file at it, so the database is already up by this
      // point and the app's own `compose up --wait` is a no-op rather than the
      // duplicate-container-name conflict it used to be.
      "envFile": "${workspaceFolder}/.env",
      // NOT integratedTerminal. That path makes the debug adapter hand the
      // java command to a terminal and then wait for the JVM to dial back on
      // JDWP; here the JVM never starts and the session dies with
      // "Failed to launch debuggee in terminal ... TransportTimeoutException".
      // internalConsole has the adapter spawn the JVM itself. Output lands in
      // the Debug Console; neither entry point reads stdin.
      "console": "internalConsole"
    },
    {
      "type": "java",
      "name": "API: Spring Boot (Ollama, local GPU)",
      "request": "launch",
      "mainClass": "dev.specra.api.SpecraApiApplication",
      "projectName": "specra-api",
      "cwd": "${workspaceFolder}/apps/api",
      // Brings up Postgres and the local model server, in parallel, and waits
      // for both.
      "preLaunchTask": "specra: db + ollama up",
      // Frees the GPU when the debug session ends. The weights stay on disk, so
      // the next start costs seconds, not another download.
      "postDebugTask": "specra: ollama down",
      "envFile": "${workspaceFolder}/.env",
      // `env` wins over `envFile`, so this runs on the local model whatever .env
      // says, without editing .env to switch back and forth.
      //
      // Chat only. AI_EMBEDDING_PROVIDER stays on transformers, which is already
      // local and free: ollama's nomic-embed-text emits 768 dimensions against
      // transformers' 384, and pgvector fixes the column width at creation, so
      // switching it means dropping vector_store first ("specra: db reset").
      "env": {
        "AI_CHAT_PROVIDER": "ollama"
      },
      // See "API: Spring Boot" for why this is not integratedTerminal.
      "console": "internalConsole"
    },

    // ── Web ──────────────────────────────────────────────────────────────────
    {
      "type": "node-terminal",
      "name": "Web: full stack (server + browser)",
      "request": "launch",
      // Use Webpack for VS Code debugging: the reported Turbopack HMR virtual
      // source paths are not readable JSON source maps on Windows.
      "command": "pnpm dev --webpack",
      "cwd": "${workspaceFolder}/apps/web",
      // Opens Chrome once Next prints its URL, so breakpoints in server
      // components and in client components both bind in one session.
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    // ── Runner ───────────────────────────────────────────────────────────────
    {
      "type": "node-terminal",
      "name": "Runner: job server",
      "request": "launch",
      // The Node/Playwright plane on :8090. Without it every codegen and every
      // run fails at the HTTP call in RunExecutor — the API has nothing to talk
      // to, and the failure surfaces as a run that goes straight to ERROR.
      "command": "pnpm start",
      "cwd": "${workspaceFolder}/services/runner",
      // Carries RUNNER_PORT and SPECRA_ENGINE_TYPES. The latter is what decides
      // whether generated code is typechecked before it is proposed; the runner
      // prints which mode it is in at startup, so the Debug Console says so.
      "envFile": "${workspaceFolder}/.env"
    },

    {
      "type": "node-terminal",
      "name": "Web: Vitest (current file)",
      "request": "launch",
      // Vitest treats bare arguments as path filters, so the basename is enough.
      // The whole suite is the "web: check" task, or `pnpm test:web` from root.
      "command": "pnpm exec vitest run ${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}/apps/web"
    }
  ],

  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API: Spring Boot", "Web: full stack (server + browser)"],
      "stopAll": true,
      "presentation": { "group": "1-specra", "order": 1 }
    },
    {
      // One button for the free local setup: Postgres and the model server come
      // up first (the API entry's preLaunchTask), the API runs on qwen2.5:7b,
      // and Next plus Chrome start alongside it. Ending the session stops all
      // three and frees the GPU.
      "name": "Full stack (Ollama, local GPU)",
      "configurations": [
        "API: Spring Boot (Ollama, local GPU)",
        "Web: full stack (server + browser)"
      ],
      "stopAll": true,
      "presentation": { "group": "1-specra", "order": 2 }
    },
    {
      // The whole product: API, web, and the runner that owns the Playwright
      // toolchain. This is what the golden path needs end to end — without the
      // runner, generation and execution both stop at the API's HTTP call to
      // :8090, so the two entries above are for working on the UI or the API
      // alone rather than for running a test.
      "name": "Web full stack (API + Web + Runner)",
      "configurations": [
        "API: Spring Boot",
        "Web: full stack (server + browser)",
        "Runner: job server"
      ],
      "stopAll": true,
      "presentation": { "group": "1-specra", "order": 3 }
    },
    {
      // The same three, with the API on the local model server: free, on the
      // GPU, no API key. Postgres and ollama come up first (the API entry's
      // preLaunchTask) and the GPU is freed when the session ends.
      "name": "Web full stack (Ollama, local GPU)",
      "configurations": [
        "API: Spring Boot (Ollama, local GPU)",
        "Web: full stack (server + browser)",
        "Runner: job server"
      ],
      "stopAll": true,
      "presentation": { "group": "1-specra", "order": 4 }
    }
  ]
}
