{
  "name": "@specra/test-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Test Model / IR contract: the JSON Schema, its TypeScript types and its fixtures. Engine-independent on purpose — it may not depend on any app, framework or execution engine.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/test-model.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "schema",
    "src",
    "fixtures"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
