# Copy to .env (repo root, read by docker compose) and to apps/api/.env if you
# prefer file-based config over exported environment variables.

# ── database ────────────────────────────────────────────────────────────────
DB_NAME=specra
DB_USER=specra
DB_PASSWORD=specra
DB_HOST=localhost
DB_PORT=5433

# ── which models run ────────────────────────────────────────────────────────
# chat:      anthropic | openai | ollama
# embedding: transformers | openai | ollama      (anthropic has no embeddings)
#
# `transformers` runs a local ONNX model, needs no key, and produces 384-dim
# vectors. Changing the embedding provider changes the vector width, so drop the
# vector_store table when you switch:  npm run db:reset
AI_CHAT_PROVIDER=anthropic
AI_EMBEDDING_PROVIDER=transformers

# ── provider credentials (only the active one has to be set) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── wiring ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
