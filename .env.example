# Copy to .env (repo root, read by docker compose) and to apps/api/.env if you
# prefer file-based config over exported environment variables.

# ── database ────────────────────────────────────────────────────────────────
DB_NAME=specra
DB_USER=specra
DB_PASSWORD=specra
DB_HOST=localhost
DB_PORT=5432

# ── which models run ────────────────────────────────────────────────────────
# chat:      anthropic | openai | ollama
# embedding: transformers | openai | ollama      (anthropic has no embeddings)
#
# Nothing here has to cost money. `ollama` + `transformers` is a complete setup
# with no API key and no account: ollama serves a chat model from your own GPU,
# transformers runs a local ONNX embedding model. That pairing is the default
# below, so a fresh checkout works before anyone has a budget.
#
# Neither provider needs a key, so leaving the two *_API_KEY lines empty is fine.
# The API boots without them either way and reports `ai-not-configured` on the AI
# endpoints rather than failing to start.
#
# Changing the *embedding* provider changes the vector width (transformers 384,
# ollama 768, openai 1536) and pgvector fixes that at table creation, so drop the
# vector_store table when you switch:  pnpm db:reset
AI_CHAT_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=transformers

# ── provider credentials (only the active one has to be set) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# No key: ollama serves models from this machine. `ollama serve` starts it, or use
# the "specra: ollama up" VS Code task, or the "API: Spring Boot (Ollama, local
# GPU)" launch configuration, which starts it and stops it with the session.
#
# The model must support tool calling — the assistant reaches saved content through
# @Tool methods, and a model without tools answers as if the tools were not there.
# qwen2.5:7b is ~4.7 GB and fits an 8 GB card with room for context; drop to
# llama3.2 (3B, ~2 GB) on a smaller GPU, or qwen2.5:14b on 16 GB or more.
#   ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── assistant health probe ──────────────────────────────────────────────────
# The API sends one throwaway token to the chat provider on this interval and
# caches the result, so GET /api/ai/health can answer "is the assistant working"
# without waiting for someone's question to be the thing that finds out.
#
# ISO-8601 durations (PT5M, PT30S) — the scheduler parses no other form.
#
# On ollama the probe is free. On a metered provider PT5M is ~288 one-token calls
# a day; lengthen it, or set AI_HEALTH_ENABLED=false to stop probing altogether.
# Disabling only stops the timer: /api/ai/health?refresh=true still probes on
# demand, so a "test connection" button keeps working either way.
AI_HEALTH_ENABLED=true
AI_HEALTH_INTERVAL=PT5M
AI_HEALTH_TIMEOUT=PT10S

# ── wiring ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── observability ───────────────────────────────────────────────────────────
# Fraction of requests that get a trace. 1.0 in development, lower in production
# where sampling exists to control cost rather than to be complete.
TRACING_SAMPLE_RATE=1.0

# ── secrets at rest ─────────────────────────────────────────────────────────
# AES key (base64 → 16, 24 or 32 bytes) that encrypts secrets Specra stores —
# a workspace's own provider API key today, environment secrets later. Optional
# in development: left unset, everything runs and only *saving* a key in
# Settings → AI assistant is refused with an error naming this variable.
#   openssl rand -base64 32
SPECRA_ENCRYPTION_KEY=

# ── sign-in ─────────────────────────────────────────────────────────────────
# The key access tokens are signed with. Anyone who knows it can mint a token
# for any account, so the built-in development default is exactly that — the
# API logs a warning while it is in use, and the `prod` profile has no default
# at all, so a deployment that forgets this variable fails to start.
#   openssl rand -base64 48
SPECRA_JWT_SECRET=

# How long an access token lives. It is verified by signature alone and never
# looked up, so revoking a session takes effect at the next refresh: this is
# that delay, in minutes. The refresh token's life is in days.
SPECRA_JWT_ACCESS_MINUTES=15
SPECRA_JWT_REFRESH_DAYS=30

# Password guessing, throttled per account. The lock expires on its own — a
# permanent one turns an attack on a user into a support ticket from that user.
SPECRA_LOCKOUT_MAX_ATTEMPTS=5
SPECRA_LOCKOUT_DURATION=PT15M

# Set false once this installation has its people: sign-up closes, and accounts
# are created by adding an address to a workspace instead.
SPECRA_REGISTRATION_OPEN=true

# --- Runner: the Node service that generates and runs Playwright code ---
# Started with: pnpm --filter specra-runner start
RUNNER_BASE_URL=http://127.0.0.1:8090
RUNNER_TIMEOUT=PT30S

# --- Xray / Jira ---
# The base URL must include the context path if Jira runs under one
# (https://jira.example.com/jira), otherwise every REST call 404s.
XRAY_BASE_URL=https://jira.example.com/jira
XRAY_PROJECT_KEY=ABC
# A Personal Access Token, not a password: the provider sends it as a Bearer token.
XRAY_TOKEN=

